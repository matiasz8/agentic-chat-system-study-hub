#!/bin/bash

echo ""
echo "🔗 Validando links antes de commit..."
echo ""

./scripts/validate-links.sh

if [ $? -ne 0 ]; then
    echo ""
    echo "⚠️  COMMIT BLOQUEADO: Hay links rotos"
    echo ""
    echo "Para solucionar:"
    echo "1. Revisa los links listados arriba"
    echo "2. Corrige o elimina los links rotos"
    echo "3. Intenta commit de nuevo"
    echo ""
    echo "O si necesitas saltarte esta validación:"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

exit 0
